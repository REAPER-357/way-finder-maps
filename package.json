{
  "name": "bluejay-bookmarks",
  "version": "2.0.0",
  "private": true,
  "description": "Blue Jay Bookmarks - offline web app wrapped for Android with Capacitor",
  "scripts": {
    "test": "node tests/core.test.js && node tests/sync.test.js",
    "build": "node scripts/build.js",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "tailwindcss": "^3.4.0"
  }
}
